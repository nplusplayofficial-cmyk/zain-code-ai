# Backend listens here
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Local-first default provider
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional cloud provider (only enabled when AI_PROVIDER=gemini)
# Obtain a key from Google AI Studio; never put it in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
